{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/cdk-hnb659fds-*"
    },
    {
      "Sid": "ReadCdkBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*:*:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "ReadStackState",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks", "cloudformation:DescribeStackEvents", "cloudformation:GetTemplate"],
      "Resource": "*"
    },
    {
      "Sid": "HotswapFunctionCode",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunTheSeedFunction",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "*"
    },
    {
      "Sid": "InspectEventSourceMappings",
      "Effect": "Allow",
      "Action": ["lambda:ListEventSourceMappings", "lambda:GetEventSourceMapping"],
      "Resource": "*"
    },
    {
      "Sid": "PurgeTheClusterSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:DeleteSecret"],
      "Resource": "*"
    },
    {
      "Sid": "ReadWorkerLogs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:FilterLogEvents", "logs:GetLogEvents"],
      "Resource": "*"
    }
  ]
}
