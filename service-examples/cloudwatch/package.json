{
  "name": "@lambda-event-router/service-example-cloudwatch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsx scripts/checkRoutes.ts",
    "trigger": "tsx scripts/trigger.ts",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval never",
    "watch": "cdk watch --hotswap-fallback",
    "destroy": "cdk destroy --force"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "catalog:",
    "@lambda-event-router/base": "workspace:*",
    "@lambda-event-router/cloudwatch": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.190.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
