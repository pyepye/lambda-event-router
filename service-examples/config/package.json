{
  "name": "@lambda-event-router/service-example-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsx scripts/checkRoutes.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval never",
    "watch": "cdk watch --hotswap-fallback",
    "destroy": "tsx scripts/emptyDeliveryBucket.ts && cdk destroy --force"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1034.0",
    "@aws-sdk/client-config-service": "^3.1034.0",
    "@aws-sdk/client-lambda": "^3.1034.0",
    "@aws-sdk/client-s3": "^3.1034.0",
    "@lambda-event-router/base": "workspace:*",
    "@lambda-event-router/config": "workspace:*",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.190.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
