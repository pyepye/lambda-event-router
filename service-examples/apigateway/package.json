{
  "name": "@lambda-event-router/service-example-apigateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "trigger": "tsx scripts/trigger.ts",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval never",
    "watch": "cdk watch --hotswap-fallback",
    "destroy": "cdk destroy --force"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-api-gateway": "^3.1034.0",
    "@aws-sdk/client-cloudformation": "^3.1034.0",
    "@aws-sdk/credential-providers": "^3.1034.0",
    "@lambda-event-router/apigateway": "workspace:*",
    "@lambda-event-router/base": "workspace:*",
    "@smithy/protocol-http": "^5.1.0",
    "@smithy/signature-v4": "^5.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.190.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "ws": "^8.18.0"
  }
}
