{
  "name": "@lambda-event-router/full-example-cognito-eventbridge-s3-avatars",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
