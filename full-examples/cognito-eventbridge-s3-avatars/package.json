    "@lambda-event-router/s3": "workspace:*",
    "@aws-sdk/client-s3": "^3.1034.0",
    "jimp": "^1.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1034.0",
    "@aws-sdk/client-cloudtrail": "3.1075.0",
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
