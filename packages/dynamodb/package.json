{
  "name": "@lambda-event-router/dynamodb",
  "version": "0.1.0",
  "description": "DynamoDB Stream handler for lambda-event-router",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && tsup",
    "dev": "tsup --watch",
    "test": "tsc --noEmit && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/util-dynamodb": "catalog:",
    "@lambda-event-router/base": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "catalog:",
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "catalog:",
    "@lambda-event-router/testing": "workspace:*",
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "vitest": "catalog:"
  }
}
