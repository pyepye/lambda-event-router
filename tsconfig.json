{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "references": [
    { "path": "./packages/base" },
    { "path": "./packages/alb" },
    { "path": "./packages/apigateway" },
    { "path": "./packages/appsync" },
    { "path": "./packages/cloudformation" },
    { "path": "./packages/cloudwatch" },
    { "path": "./packages/codecommit" },
    { "path": "./packages/codepipeline" },
    { "path": "./packages/cognito" },
    { "path": "./packages/config" },
    { "path": "./packages/connect" },
    { "path": "./packages/documentdb" },
    { "path": "./packages/dynamodb" },
    { "path": "./packages/eventbridge" },
    { "path": "./packages/firehose" },
    { "path": "./packages/iot" },
    { "path": "./packages/kafka" },
    { "path": "./packages/kinesis" },
    { "path": "./packages/lex" },
    { "path": "./packages/mq" },
    { "path": "./packages/s3" },
    { "path": "./packages/secretsmanager" },
    { "path": "./packages/ses" },
    { "path": "./packages/sns" },
    { "path": "./packages/sqs" },
    { "path": "./packages/stepfunctions" },
    { "path": "./packages/vpclattice" },
    { "path": "./packages/testing" }
  ]
}
